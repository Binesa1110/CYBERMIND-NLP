# Copy this file to .env for local use, then replace placeholders locally.
# Never commit .env or put real credentials in this file.

CYBERMIND_MAX_MESSAGE_LENGTH=5000
CYBERMIND_ALLOWED_ORIGINS=
CYBERMIND_LOG_LEVEL=INFO

GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/callback
SESSION_SECRET_KEY=replace-with-a-random-value-at-least-32-bytes
TOKEN_ENCRYPTION_KEY=generate-a-valid-fernet-key
CYBERMIND_GMAIL_DATABASE=
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id
GMAIL_PUBSUB_TOPIC=your-pubsub-topic-id
GMAIL_PUBSUB_SUBSCRIPTION=your-pubsub-subscription-id
GMAIL_PUBSUB_MODE=pull
CYBERMIND_GMAIL_DEPLOYMENT=local
GMAIL_PUBSUB_PUSH_AUDIENCE=
GMAIL_PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=
